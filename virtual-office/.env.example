# Virtual Office — Environment Variables
# Copy this file to .env and fill in your values

# ── Core ──────────────────────────────────────────────────────────────────────
OFFICE_DIR=                        # Absolute path to this virtual-office/ folder
                                   # e.g. /Users/you/projects/digital-leadership/virtual-office

# ── AI Keys ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...       # Required for Claude-powered employees

# ── Obsidian Reporter ─────────────────────────────────────────────────────────
OBSIDIAN_VAULT=/Users/you/ObsidianVault
OBSIDIAN_NOTES_DIR=Virtual Office / Reports

# ── Grok Bot (optional) ───────────────────────────────────────────────────────
GROK_URL=https://grok.com
GROK_HEADLESS=true                 # Set false to see the browser window
GROK_TIMEOUT_MS=60000
CHROMIUM_PATH=                     # Leave blank to use Playwright's bundled Chromium

# ── Lion Supervisor Alerts ────────────────────────────────────────────────────
NOTIFICATION_EMAIL=you@example.com
SUPERVISOR_THRESHOLD=3             # Consecutive failures before alert

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password        # Use a Gmail App Password, not your main password

# ── State API ─────────────────────────────────────────────────────────────────
STATE_PORT=5050                    # Port for the Flask state server (default: 5050)
