# Copy this file to .env (or .env.local) and fill in real values for local
# development. Never commit the filled-in file — see ENVIRONMENT.md.
#
# Every variable here is validated by src/config/env.ts. Variables marked
# "not used yet" are placeholders for a later phase and are safe to leave
# blank until that phase's documentation says otherwise.

NODE_ENV=development
PORT=4000

# --- Database (Phase 5 schema implemented; live project now required for
# Phase 6 authentication to actually resolve/provision users — see
# DATABASE_IMPLEMENTATION_REPORT.md and GOOGLE_OAUTH_SETUP.md) ---
# From your Supabase project: Project Settings > Database (DATABASE_URL)
# and Project Settings > API (SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY).
# DATABASE_URL is what src/lib/db.ts actually connects with; the other two
# are reserved for Phase 7+ (Storage, admin operations via the Supabase
# client library) and are not read by any code yet.
DATABASE_URL=
SUPABASE_URL=
# Service-role keys are highly privileged — never expose this to any client,
# never commit it, and never log it (SECURITY_ARCHITECTURE.md §10).
SUPABASE_SERVICE_ROLE_KEY=

# --- Phase 6 (Authentication & Authorization) ---
# From your Supabase project: Settings > API > JWT Settings > JWT Secret.
# This is what src/auth/verifySupabaseToken.ts uses to verify a session
# token's signature without a network round-trip. Server-only — never
# expose this to web or mobile. See GOOGLE_OAUTH_SETUP.md.
SUPABASE_JWT_SECRET=

# NOTE: there are no GOOGLE_OAUTH_CLIENT_ID/SECRET or SESSION_SIGNING_SECRET
# variables here (present in earlier phase scaffolding, now removed —
# DECISIONS.md D36/D37). Google OAuth is configured entirely inside the
# Supabase dashboard, and this backend does not mint its own session token
# — it verifies Supabase's token directly on every request. See
# AUTHENTICATION.md for the full reasoning.

# --- File storage (Phase 7+) — not used yet ---
FILE_STORAGE_BUCKET=
