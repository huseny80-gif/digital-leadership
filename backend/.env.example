# Copy this file to .env (or .env.local) and fill in real values for local
# development. Never commit the filled-in file — see ENVIRONMENT.md.
#
# Every variable here is validated by src/config/env.ts. Variables marked
# "not used yet" are placeholders for a later phase and are safe to leave
# blank until that phase's documentation says otherwise.

NODE_ENV=development
PORT=4000

# --- Database (Phase 5 schema implemented; no live Supabase project yet — see
# DATABASE_IMPLEMENTATION_REPORT.md) ---
# Fill these in once a Supabase project exists: Project Settings > Database
# (DATABASE_URL / connection string) and Project Settings > API (SUPABASE_URL,
# SUPABASE_SERVICE_ROLE_KEY). The backend has no code that reads these yet
# (that lands when Phase 6 wires up a real database client) — the schema in
# supabase/migrations/ is ready to apply via `supabase db push` once a
# project is linked.
DATABASE_URL=
SUPABASE_URL=
# Service-role keys are highly privileged — never expose this to any client,
# never commit it, and never log it (SECURITY_ARCHITECTURE.md §10).
SUPABASE_SERVICE_ROLE_KEY=

# --- Phase 6 (Authentication & Authorization) — not used yet ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Generate with e.g. `openssl rand -base64 32` when this phase implements it.
SESSION_SIGNING_SECRET=

# --- File storage (Phase 6/7) — not used yet ---
FILE_STORAGE_BUCKET=
