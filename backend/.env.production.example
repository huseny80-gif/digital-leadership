# Production environment variable template for the backend, for a hosting
# provider's dashboard (Railway/Render/Fly) — not a file to load from
# disk in production (unlike backend/.env.example, which is for local
# `npm run dev`/`npm start`). Copy each value into the provider's env-var
# UI, never into a committed file. See ENVIRONMENT.md for full context on
# each variable.
#
# SECURITY: every value marked (SECRET) is highly privileged. Never log
# it, never expose it to the web/mobile clients, never commit a filled-in
# copy of this file.

NODE_ENV=production
PORT=4000

# --- Database & Auth (both REQUIRED for the backend to serve any
# authenticated request — see backend/.env.example's own comment on
# SUPABASE_URL for what breaks without it) ---
# From the Supabase project: Project Settings > Database > Connection
# string (use the pooled "Transaction" connection string, not "Session",
# for a PaaS deployment — see security note #1 in DEPLOYMENT.md).
DATABASE_URL=
# From the Supabase project: Project Settings > API > Project URL.
SUPABASE_URL=
# From the Supabase project: Project Settings > API > service_role key.
# (SECRET) Never expose this to any client. Required for Storage/admin
# operations; also required to avoid the local-filesystem storage
# fallback (see DEPLOYMENT.md security note #2).
SUPABASE_SERVICE_ROLE_KEY=

# --- CORS (REQUIRED — must list the real production web origin, not the
# schema default of localhost:3000) ---
# Comma-separated, no spaces needed but allowed (trimmed). Include every
# origin the web app is actually served from (production domain, and any
# Vercel preview URLs you want the API to accept requests from).
CORS_ALLOWED_ORIGINS=https://your-production-web-domain.example.com

# --- File storage (REQUIRED to be set correctly for production; see
# DEPLOYMENT.md security note #2 for why leaving this at its code default
# is unsafe) ---
SUPABASE_STORAGE_BUCKET=educational-files
MAX_PDF_SIZE_BYTES=20971520
SIGNED_URL_EXPIRY_SECONDS=300
# LOCAL_STORAGE_DIR is intentionally omitted here — it must never be used
# in production (see DEPLOYMENT.md security note #3). It is only read if
# SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY are absent, which should never be
# true once the two variables above are set.
# (SECRET) Only relevant if the app ever falls back to local storage —
# generate a real random value and set it anyway, as a guard against that
# fallback ever being silently reached. Never use the code default.
LOCAL_STORAGE_SIGNING_SECRET=

# --- Retired, safe to leave blank (kept only for backward compatibility
# in src/config/env.ts — see that file's comment) ---
SUPABASE_JWT_SECRET=
