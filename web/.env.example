# Copy this file to .env.local for local development. Never commit the
# filled-in file — see ENVIRONMENT.md.
#
# Only NEXT_PUBLIC_* variables are readable by browser code, so only
# non-sensitive, client-safe values belong here (SECURITY_ARCHITECTURE.md
# §10) — no secret, API key, or service-role credential ever goes in a
# NEXT_PUBLIC_* variable. See GOOGLE_OAUTH_SETUP.md for the full
# client-safe-vs-server-only breakdown.

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Phase 6 (Authentication & Authorization) ---
# From your Supabase project's Settings > API page. The anon key is
# client-safe by design (Supabase's row-level security is what actually
# gates data access for it — see DATABASE_SECURITY.md) — it is NOT the
# service-role key, which must never appear here or anywhere in web/.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NOTE: there is no Google Client ID variable here. Google OAuth is
# configured entirely inside the Supabase dashboard (see
# GOOGLE_OAUTH_SETUP.md) — this app never talks to Google directly.
