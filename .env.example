# ─────────────────────────────────────────────
# Database (PostgreSQL — Neon, Supabase, Railway, etc.)
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"

# ─────────────────────────────────────────────
# NextAuth v5 / Auth.js
# AUTH_URL  = the full public URL of your deployment (no trailing slash)
# AUTH_SECRET = random 32-byte secret: `openssl rand -base64 32`
# ─────────────────────────────────────────────
AUTH_URL="https://your-app.vercel.app"
AUTH_SECRET="REPLACE_WITH_RANDOM_SECRET"

# NEXTAUTH_URL is read by next.config.ts for allowedOrigins
NEXTAUTH_URL="https://your-app.vercel.app"

# ─────────────────────────────────────────────
# Session signing key for participant JWT (guest_token cookie)
# Falls back to AUTH_SECRET if not set — set explicitly for clarity
# ─────────────────────────────────────────────
SESSION_SECRET="REPLACE_WITH_RANDOM_SECRET"

# ─────────────────────────────────────────────
# AI — Anthropic Claude (required for question generation)
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ─────────────────────────────────────────────
# Document parsing — LlamaCloud (optional; falls back to basic extraction)
# ─────────────────────────────────────────────
# LLAMA_CLOUD_API_KEY="llx-..."

# ─────────────────────────────────────────────
# File storage — Vercel Blob (optional; falls back to local disk)
# Required in production if you want document uploads to persist
# ─────────────────────────────────────────────
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ─────────────────────────────────────────────
# Local storage root (only used when BLOB_READ_WRITE_TOKEN is absent)
# ─────────────────────────────────────────────
# STORAGE_ROOT="/var/data/uploads"
